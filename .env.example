# Можно скопипастить этот файл в .env и при необходимости поменять значения.

# Строка подключения к БД.
# SQLite (файл app.db в корне проекта):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL (нужно доустановить драйвер: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/threads

# Секрет для подписи JWT-токенов. Сгенерировать можно так:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Время жизни токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=60
